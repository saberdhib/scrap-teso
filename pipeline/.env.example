# Copier en .env puis ajuster. Tout a une valeur par défaut sauf HF_TOKEN.

# --- PostgreSQL ---
POSTGRES_USER=aciege
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aciege

# --- MinIO ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-aussi
MINIO_BUCKET_THESES=theses
MINIO_BUCKET_RAPPORTS=rapports

# --- Hugging Face (OBLIGATOIRE pour l'arbitrage LLM, cf. BESOINS.md) ---
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# --- Modèles ---
EMBED_MODEL=BAAI/bge-m3
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# --- Lecture des thèses ---
MAX_PAGES=5
MIN_CHARS_INFORMATIF=1200
BATCH_SIZE=1000
