    skos:inScheme <https://aciege.org/concept/scheme> .

<https://aciege.org/concept/term/331_75> a skos:Concept ;
    skos:prefLabel "THEORIE DU MARCHE"@fr ;
    skos:notation "331_75" ;
    skos:definition "Nommée également théorie des prix, ou théorie microéconomique. La théorie du marché étudie le comportement des offreurs et des demandeurs sur les différents marchés des biens et des services et les relations s'établissant entre eux. (ALQUIER C.- Dict. encycl. éco. et social)"@fr ;
    dct:source "ALQUIER C.- Dict. encycl. éco. et social" ;
    skos:broader <https://aciege.org/concept/sg/331> ;
    skos:broader <https://aciege.org/concept/term/331_55> ;
    skos:narrower <https://aciege.org/concept/term/331_95> ;
    skos:narrower <https://aciege.org/concept/term/331_64> ;
    skos:narrower <https://aciege.org/concept/term/331_84> ;
    skos:narrower <https://aciege.org/concept/term/331_74> ;
    skos:narrower <https://aciege.org/concept/term/331_94> ;
    skos:inScheme <https://aciege.org/concept/scheme> .

