<https://aciege.org/concept/term/429_63> a skos:Concept ;
    skos:prefLabel "THERMALISME SECTEUR"@fr ;
    skos:notation "429_63" ;
    skos:altLabel "Thalassothérapie secteur"@fr ;
    skos:definition "Selon le Haut Comité Français du Thermalisme, le thermalisme regroupe l'ensemble des traitements exclusivement médicaux, internes et externes, qui utilisent l'eau minérale et ses dérivés (vapeur, gaz et boues thermales) (Autres services.- Xerfi.- 1997)"@fr ;
    dct:source "Autres services.- Xerfi.- 1997" ;
    skos:broader <https://aciege.org/concept/sg/429> ;
    skos:broader <https://aciege.org/concept/term/429_53> ;
    skos:inScheme <https://aciege.org/concept/scheme> .
